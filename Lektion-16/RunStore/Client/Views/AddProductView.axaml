<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.AddProductView"
             x:DataType="vm:AddProductViewModel">

  <Design.DataContext>
    <vm:AddProductViewModel></vm:AddProductViewModel>
  </Design.DataContext>

  <StackPanel>
    <Label Classes="pageTitle" Content="{Binding PageTitle}" />
    <Border
      HorizontalAlignment="Center"
      Margin="0 20 0 10"
      Padding="20"
      BorderBrush="{DynamicResource ForegroundColor}"
      BorderThickness="1">
      <StackPanel>
        <StackPanel Margin="0 0 0 10" Orientation="Horizontal">
          <Label Width="150" Content="Artikelnr" />
          <TextBox Text="{Binding ItemNumber}" Width="200" MinWidth="200" />
        </StackPanel>
        <StackPanel Margin="0 0 0 10" Orientation="Horizontal">
          <Label Width="150" Content="Produktnamn" />
          <TextBox Text="{Binding ProductName}" Width="200" MinWidth="200" />
        </StackPanel>
        <StackPanel Margin="0 0 0 10" Orientation="Horizontal">
          <Label Width="150" Content="Leverantör" />
          <TextBox Text="{Binding Supplier}" Width="200" MinWidth="200" />
        </StackPanel>
        <StackPanel Margin="0 0 0 10" Orientation="Horizontal">
          <Label Width="150" Content="Pris" />
          <TextBox Text="{Binding Price}" Width="200" MinWidth="200" />
        </StackPanel>
        <StackPanel Margin="0 20 0 0">
          <Button Command="{Binding AddCommand}" Content="Spara" Width="100" HorizontalAlignment="Center" HorizontalContentAlignment="Center"></Button>
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
