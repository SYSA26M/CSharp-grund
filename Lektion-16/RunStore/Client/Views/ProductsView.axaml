<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.ProductsView"
             x:DataType="vm:ProductsViewModel">

  <Design.DataContext>
    <vm:ProductsViewModel></vm:ProductsViewModel>
  </Design.DataContext>

  <StackPanel>
    <Label Classes="pageTitle" Content="{Binding PageTitle}" />
    <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToAddProductCommand}">
      <StackPanel Orientation="Horizontal">
        <Label FontFamily="{DynamicResource IconFont}" Content="&#xe3d4;" Padding="0 5 5 0" />
        <Label Content="Lägg till ny produkt"/>
      </StackPanel>
    </Button>

    <Border
      BorderBrush="{DynamicResource ForegroundColor}"
      BorderThickness="0 0 0 1" Padding="0 50 0 0">
      <!-- Rubriker -->
      <Grid ColumnDefinitions="100,200,200,*,35,35" ShowGridLines="False">
        <Label Content="Artikelnr" />
        <Label Grid.Column="1" Content="Produktnamn" />
        <Label Grid.Column="2" Content="Leverantör" />
        <Label Grid.Column="3" Content="Priset" HorizontalAlignment="Right" />
        <Label Grid.Column="4"/>
        <Label Grid.Column="5"/>
      </Grid>
    </Border>
    <!-- Data -->
    <ScrollViewer Height="300">
      <ItemsControl Padding="0 5" ItemsSource="{Binding Products}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="100,200,200,*,35,35" ShowGridLines="False">
              <Label Content="{Binding ItemNumber}" />
              <Label Grid.Column="1" Content="{Binding Name}" />
              <Label Grid.Column="2" Content="{Binding SupplierName}" />
              <Label Grid.Column="3" Content="{Binding Price}" HorizontalAlignment="Right" />
              <Button Grid.Column="4"
                      Classes="icon"
                      Command="{Binding $parent[UserControl].DataContext.EditCommand}"
                      CommandParameter="{Binding Id}"
                      FontFamily="{DynamicResource IconFont}"
                      Content="&#xE3B4;"
                      HorizontalAlignment="Center" />
              <Button Grid.Column="5"
                      Classes="icon-danger"
                      Command="{Binding $parent[UserControl].DataContext.DeleteCommand}"
                      CommandParameter="{Binding Id}"
                      FontFamily="{DynamicResource IconFont}"
                      Content="&#xE4A6;"
                      HorizontalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </StackPanel>
</UserControl>
