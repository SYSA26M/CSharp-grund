<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Client"
             x:Class="Client.App"
             RequestedThemeVariant="Dark">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator></local:ViewLocator>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="Assets/Styles/AppStyles.axaml"></StyleInclude>
    </Application.Styles>

    <Application.Resources>
        <Color x:Key="PrimaryBackgroundColor">#1E1A4D</Color>
        <Color x:Key="PrimaryForegroundColor">#f4f4f4</Color>
        <Color x:Key="PrimaryButtonBackgroundColor">#17165D</Color>
        <Color x:Key="PrimaryButtonForegroundColor">#25217C</Color>
        <Color x:Key="ButtonIconColor">#1DE31D</Color>
        <Color x:Key="ButtonIconDangerColor">Red</Color>

        <SolidColorBrush x:Key="BackgroundColor" Color="{DynamicResource PrimaryBackgroundColor}" />
        <SolidColorBrush x:Key="ForegroundColor" Color="{DynamicResource PrimaryForegroundColor}" />
        <SolidColorBrush x:Key="ButtonBackground" Color="{DynamicResource PrimaryButtonBackgroundColor}" />
        <SolidColorBrush x:Key="ButtonHoverBackground" Color="{DynamicResource PrimaryButtonForegroundColor}" />
        <SolidColorBrush x:Key="ButtonIcon" Color="{DynamicResource ButtonIconColor}" />
        <SolidColorBrush x:Key="ButtonIconDanger" Color="{DynamicResource ButtonIconDangerColor}" />

        <LinearGradientBrush x:Key="SideBarGradient" StartPoint="0% 0%" EndPoint="0% 100%">
            <GradientStop Offset="0" Color="#1E1A4D" />
            <GradientStop Offset="1" Color="#372aac"/>
        </LinearGradientBrush>

        <FontFamily x:Key="BaseFont">avares://Client/Assets/Fonts#Montserrat</FontFamily>
        <FontFamily x:Key="IconFont">avares://Client/Assets/Fonts/Phosphor.ttf#Phosphor</FontFamily>
    </Application.Resources>


</Application>